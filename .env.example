# ─── FIREBASE ────────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=o-teu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=o-teu-projeto
VITE_FIREBASE_STORAGE_BUCKET=o-teu-projeto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123

# ─── ANTHROPIC ───────────────────────────────────────────────────────────────
# Esta key é usada APENAS no servidor (Netlify Function) — nunca exposta no browser
# Vai para: Netlify → Site → Environment variables → Add variable
# Nome: ANTHROPIC_API_KEY  (sem VITE_ !)
# Valor: sk-ant-api03-...
#
# Obtém a key em: https://console.anthropic.com/settings/keys
# NUNCA coloques aqui VITE_ANTHROPIC_API_KEY — ficaria visível no browser!

# ─── GROQ (Day Trading — muito mais barato para scans frequentes) ─────────────
# Gratuito até 14.400 requests/dia — mais que suficiente para scans a cada 5min
# Regista em: https://console.groq.com → API Keys → Create
# Coloca no Netlify: Environment variables → GROQ_API_KEY
# NUNCA com VITE_ (fica no servidor)
GROQ_API_KEY=gsk_...
